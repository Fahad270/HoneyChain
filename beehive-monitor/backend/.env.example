MONGODB_URI=mongodb+srv://<user>:<pass>@cluster.mongodb.net/honeychain
# ---- Two-tier accounts (beekeeper | kvic) ----
# Signs login JWTs. Set a long random string in production.
JWT_SECRET=change-me-to-a-long-random-string
ANTHROPIC_API_KEY=<your-anthropic-key>
ANTHROPIC_MODEL=claude-sonnet-4-5
# ---- Aadhaar / DigiLocker KYC ----
# Demo OTP is returned in the API response so the flow works without an SMS
# gateway. Set false in production and wire a real OTP sender.
ALLOW_DEMO_OTP=true
# Reject registrations whose Aadhaar fails the offline Verhoeff check.
STRICT_AADHAAR=false
# DigiLocker Requester (partner) credentials — api.digitallocker.gov.in.
# Until set, /api/kyc/digilocker/* runs in honest demo mode.
DIGILOCKER_CLIENT_ID=
DIGILOCKER_CLIENT_SECRET=
DIGILOCKER_REDIRECT_URI=http://localhost:5000/api/kyc/digilocker/callback
PINATA_JWT=<your-pinata-jwt>
PINATA_GATEWAY=https://gateway.pinata.cloud
CHAIN_REGISTRY_KEY=<from-remix-deploy>
PORT=5000
